# Optional — enables AI executive summaries on the overview page.
# Without this key, the dashboard uses an accurate metrics-based summary.

OPENAI_API_KEY=

# Model for executive summaries (default: gpt-4o-mini)
# AI_SUMMARY_MODEL=gpt-4o-mini

# Set to false to force metrics-based summaries even when a key is present
# AI_SUMMARY_ENABLED=false
